{
  "axis_order": "ZYX",
  "normalization": {
    "clip": [0.0, 1.0],
    "denominator_floor": 1.0,
    "implementation": "biohub_ct.training.data.normalize_frame",
    "percentiles": [1.0, 99.8],
    "xy_downsample": "edge_pad_then_nonoverlapping_block_mean",
    "xy_stride": 4
  },
  "tiling": {
    "border_weight": "separable_positive_edge_ramp_cap_overlap",
    "iteration_order": "Z_outer_Y_middle_X_inner",
    "overlap": 16,
    "tile_input_padding": "none",
    "tile_size": 64
  }
}
